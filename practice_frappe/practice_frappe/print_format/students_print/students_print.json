 "html": "<div class=\"container\" style=\"width: 80%; margin: 30px auto;\">\n\n    <h2 style=\"text-align: center; margin-bottom: 25px;\">\n        Student Details\n    </h2>\n\n    <table class=\"table table-bordered table-striped\"\n           style=\"width: 100%; table-layout: fixed;\">\n\n        <tbody>\n\n            <tr>\n                <th style=\"width: 40%; text-align: left;\">Student ID</th>\n                <td style=\"width: 60%; text-align: left;\">{{ doc.student_id }}</td>\n            </tr>\n\n            <tr>\n                <th style=\"width: 40%; text-align: left;\">Name</th>\n                <td style=\"width: 60%; text-align: left;\">{{ doc.name1 }}</td>\n            </tr>\n\n            <tr>\n                <th style=\"width: 40%; text-align: left;\">Age</th>\n                <td style=\"width: 60%; text-align: left;\">{{ doc.age }}</td>\n            </tr>\n\n            <tr>\n                <th style=\"width: 40%; text-align: left;\">Gender</th>\n                <td style=\"width: 60%; text-align: left;\">{{ doc.gender }}</td>\n            </tr>\n\n            <tr>\n                <th style=\"width: 40%; text-align: left;\">Department</th>\n                <td style=\"width: 60%; text-align: left;\">{{ doc.department }}</td>\n            </tr>\n\n            <tr>\n                <th style=\"width: 40%; text-align: left;\">Marks</th>\n                <td style=\"width: 60%; text-align: left;\">{{ doc.marks }}</td>\n            </tr>\n\n            <tr>\n                <th style=\"width: 40%; text-align: left;\">City</th>\n                <td style=\"width: 60%; text-align: left;\">{{ doc.city }}</td>\n            </tr>\n\n        </tbody>\n    </table>\n\n</div>",
